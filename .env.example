# Copie para .env (ignorado). Gere valores aleatórios; não use credenciais demo em produção.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
PGDATABASE=estoquepro
PGUSER=estoquepro
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
PGSSLMODE=prefer
# Domínio, suporte e SMTP permanecem desativados até após a apresentação.
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
